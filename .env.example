DB_PASS=changeme
DB_ROOT_PASS=changeme_root

# ใช้ประกอบลิงก์แบบ absolute ในอีเมล (เช่น cron ที่ไม่มี HTTP request context ให้ derive host เอง)
APP_BASE_URL=https://report.icead.kku.ac.th

# Phase 1-7 ยังไม่ต้องมีค่าเหล่านี้ (ใช้ mock login แทน) — จะใช้ตอน Phase 8
SSO_APP_ID=
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
SSO_REDIRECT_URL=https://report.icead.kku.ac.th/auth/callback/login

# Login ด้วย Google (ทางเลือกคู่กับ mock login ด้านบน — ไม่ได้แทนที่ SSONext) สร้าง OAuth client
# ได้ที่ Google Cloud Console > APIs & Services > Credentials (OAuth 2.0 Client ID, ประเภท
# "Web application") ต้องตั้ง Authorized redirect URI ให้ตรงกับ GOOGLE_REDIRECT_URL เป๊ะๆ — ต้องมี
# ?r=auth/google-callback ต่อท้าย index.php เพราะแอปนี้ไม่ได้เปิด pretty URL (enablePrettyUrl) ไว้
# ทั้งระบบ ลิงก์ทุกจุดในแอปจึงใช้รูปแบบ ?r=controller/action เหมือนกันหมด ถ้าตั้งเป็น URL แบบ path
# ตรงๆ (/auth/google-callback เฉยๆ) Yii จะหา route จากมันไม่เจอ แล้วเงียบๆ ตกไปที่หน้า default
# (site/index) แทนโดยไม่ error ให้เห็นเลย
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=https://report.icead.kku.ac.th/index.php?r=auth/google-callback

# ยังไม่ใช้ในเฟสนี้ (Phase 5 - reminder emails)
MAILER_HOST=
MAILER_USER=
MAILER_PASS=
MAILER_PORT=587
